# ============================================================
# backend/.env.example
# Copy this to backend/.env for local development.
# In Docker, these are set in docker-compose.yml environment block.
# ============================================================

# Express server port
PORT=3001

# PostgreSQL connection string
DATABASE_URL=postgres://typeahead:typeahead@localhost:5432/typeahead

# Comma-separated Redis node URLs
# In Docker: use container names. Locally: use localhost with different ports
REDIS_NODES=redis://localhost:6379,redis://localhost:6380,redis://localhost:6381

# How long (seconds) to keep a prefix result in Redis cache
CACHE_TTL_SECONDS=300

# Ranking mode: "basic" (total_count) or "trending" (score formula)
RANKING_MODE=basic

# Trending score formula: score = total_count + TRENDING_ALPHA * recent_count
TRENDING_ALPHA=2.0

# Decay factor applied to recent_count periodically (0 < DECAY_FACTOR < 1)
# Example: 0.9 means recent_count shrinks by 10% each decay cycle
DECAY_FACTOR=0.9

# How often (ms) to run the decay job
DECAY_INTERVAL_MS=60000

# Batch writer: flush when buffer hits this size
BATCH_SIZE=50

# Batch writer: flush every this many milliseconds (whichever comes first)
BATCH_FLUSH_INTERVAL_MS=5000

# Number of virtual nodes per real Redis node in the consistent hash ring
# More virtual nodes = better distribution (but slightly more memory)
VIRTUAL_NODES=150

# Minimum prefix length to return suggestions (class requirement: 3)
MIN_PREFIX_LENGTH=3
