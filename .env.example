# ============================================================
# .env.example — Root level reference
# Copy relevant sections to backend/.env for local development.
# In Docker, values are set in docker-compose.yml
# ============================================================

# --- Backend ---
PORT=3001
DATABASE_URL=postgres://typeahead:typeahead@localhost:5432/typeahead
REDIS_NODES=redis://localhost:6379,redis://localhost:6380,redis://localhost:6381
CACHE_TTL_SECONDS=300
RANKING_MODE=basic
TRENDING_ALPHA=2.0
DECAY_FACTOR=0.9
DECAY_INTERVAL_MS=60000
BATCH_SIZE=50
BATCH_FLUSH_INTERVAL_MS=5000
VIRTUAL_NODES=150
MIN_PREFIX_LENGTH=3

# --- PostgreSQL (Docker) ---
POSTGRES_USER=typeahead
POSTGRES_PASSWORD=typeahead
POSTGRES_DB=typeahead
